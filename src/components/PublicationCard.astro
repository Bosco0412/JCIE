---
import type { Lang } from "../lib/i18n";
import { t } from "../lib/i18n";
import type { Publication } from "../lib/data";

type Props = { pub: Publication; lang: Lang };
const { pub, lang } = Astro.props;

const venue = pub.venue ?? "";
const year = pub.year;
const hasLink = Boolean(pub.link && pub.link !== "#");
const authors = pub.authors ?? [];
---

{hasLink ? (
  <a class="card pub-card" href={pub.link} target="_blank" rel="noopener noreferrer">
    <div class="pub-card-body">
      <h3 class="pub-card-title">{pub.title}</h3>

      {(venue || year) ? (
        <div class="pub-card-meta">
          {venue ? <span class="badge badge--pub">{venue}</span> : null}
          {year ? <span class="badge">{year}</span> : null}
        </div>
      ) : null}

      {authors.length ? <div class="small muted pub-card-authors">{authors.join(", ")}</div> : null}
    </div>

    <div class="pub-card-action">
      <span class="btn btn-ghost pub-card-btn">
        {t(lang, "查看", "View")}
        <span aria-hidden="true" class="pub-card-arrow">→</span>
      </span>
    </div>
  </a>
) : (
  <article class="card pub-card">
    <div class="pub-card-body">
      <h3 class="pub-card-title">{pub.title}</h3>

      {(venue || year) ? (
        <div class="pub-card-meta">
          {venue ? <span class="badge badge--pub">{venue}</span> : null}
          {year ? <span class="badge">{year}</span> : null}
        </div>
      ) : null}

      {authors.length ? <div class="small muted pub-card-authors">{authors.join(", ")}</div> : null}
    </div>
  </article>
)}
